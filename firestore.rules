rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /itineraries/{itineraryId} {
      // Itinerary is public to view...
      allow read: if true;
      // ...but only a signed-in (admin) user can add/edit/delete entries.
      allow write: if request.auth != null;
    }

    match /guestbook/{entryId} {
      // Entries are public to view - creation goes through the
      // submitGuestbookEntry Cloud Function (Admin SDK, bypasses these
      // rules) so it can validate/rate-limit, not through direct client
      // writes. Signed-in admin can still delete a bad entry directly.
      allow read: if true;
      allow write: if request.auth != null;

      match /replies/{replyId} {
        // Replies are public to view (shown nested under the comment) but
        // only the signed-in admin can post one - creating a reply here is
        // what triggers the notification email (see onGuestbookReply in
        // functions/index.js).
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Commenter emails, kept out of the public guestbook doc above so
    // visitors reading the guestbook can't harvest them. Only the Admin SDK
    // (submitGuestbookEntry, onGuestbookReply) and the signed-in admin
    // (moderation/cleanup) ever touch this collection - never exposed to
    // anonymous clients.
    match /guestbook_private/{entryId} {
      allow read, write: if request.auth != null;
    }

    match /galleries/{galleryId} {
      // Galleries and their photos are public to view...
      allow read: if true;
      // ...but only a signed-in (admin) user can create/rename/delete galleries
      // or add/remove photos.
      allow write: if request.auth != null;

      match /images/{imageId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
